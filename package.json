{
  "name": "connectwise-manage-mcp",
  "version": "2.0.0-sentinel",
  "description": "ConnectWise Manage (PSA) MCP server — multi-profile AI agent toolkit with Entra ID OAuth, Copilot Studio multi-agent topology, and SENTINEL write-gating",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "connectwise-manage-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "pack:mcpb": "node scripts/pack-mcpb.js",
    "validate:mcpb": "mcpb validate manifest.json",
    "secretlint": "secretlint \"**/*\"",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NZCHiLLY/connectwise-manage-mcp.git"
  },
  "keywords": [
    "mcp",
    "claude",
    "connectwise",
    "connectwise-manage",
    "psa",
    "msp"
  ],
  "author": "WYRE Technology (forked and extended by NZCHiLLY)",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/NZCHiLLY/connectwise-manage-mcp/issues"
  },
  "homepage": "https://github.com/NZCHiLLY/connectwise-manage-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "jose": "6.2.2",
    "undici": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.0",
    "@types/node": "^26.0.0",
    "eslint": "^9.39.4",
    "globals": "^17.6.0",
    "secretlint": "^13.0.2",
    "semantic-release": "^25.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
